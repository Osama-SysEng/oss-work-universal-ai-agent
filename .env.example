# ═══════════════════════════════════════════════════════════════════
# OSS Work / OS_V1 — environment configuration
# Local-first: no provider, no API key, no cloud account.
# Every value here is optional; the defaults run entirely on this machine.
# ═══════════════════════════════════════════════════════════════════

# ── PRODUCT ──
ENVIRONMENT=development
SERVICE_NAME=oss-work
LOG_LEVEL=info
GIT_SHA=dev

# ── DEVICE TIER (spec section 23) ──
# lite      — 16 GB RAM, no GPU, 128K context
# standard  — 32 GB RAM, 12-16 GB VRAM, 256K context
# pro       — 64 GB RAM, 24 GB+ VRAM, 1M context
# Leave empty to detect from the machine's memory. VRAM is never guessed.
OSS_V1_TIER=
OSS_V1_CONTEXT_TOKENS=0

# ── LOCAL INFERENCE ENGINE (llama.cpp, no keys) ──
# Start it with: C:\tools\llama\start-engine.cmd
OSS_LOCAL_URL=http://127.0.0.1:11400
OSS_LOCAL_MODEL=qwen2.5-3b-q4_k_m
OSS_LOCAL_TIMEOUT=120

# ── PATHS (all local) ──
OSS_V1_DATA_DIR=./data-osv1
OSS_V1_WORKSPACE_DIR=./workspace
OSS_V1_SKILLS_DIR=./skills-osv1
OSS_V1_KILL_SWITCH=./data-osv1/kill.switch
OSS_V1_AUDIT_LOG=./data-osv1/audit.log

# ── SAFETY LAYER (spec section 19) ──
# Human approval is required for irreversible actions. The system cannot
# change this switch, the permissions, the audit log, the kill switch, or
# the verifier's tests.
OSS_V1_REQUIRE_APPROVAL=true
OSS_V1_ALLOW_IRREVERSIBLE=false
OSS_V1_NETWORK=false
OSS_V1_MAX_FILE_BYTES=10485760
OSS_V1_MAX_OUTPUT_BYTES=65536

# ── SYSTEM ONE (spec section 9) ──
# Below this confidence System One abstains and the request asks the user.
OSS_V1_SOM_ABSTAIN=0.6
# Optional: a Laya typed-decisions checkpoint served by the local engine.
OSS_V1_LAYA_MODEL=

# ── LOCAL API AND LIVE CONSOLE ──
# The API binds to the loopback interface only.
OSS_V1_API_HOST=127.0.0.1
OSS_V1_API_PORT=8080

# ── PROGRAM CONTROL (section 12) ──
# Only these programs may be started, and only from the workspace with a
# scrubbed environment. Empty means no program may be started at all.
OSS_V1_PROGRAM_ALLOWLIST=

# ── OBSERVABILITY ──
OSS_LOG_LEVEL=INFO
