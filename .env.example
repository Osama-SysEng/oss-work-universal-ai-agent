# OSS WORK — COMPLETE ENVIRONMENT CONFIGURATION v1.0.0-dev
# NASA Space Apps Champion · AI Hackathon 1st Place
# Built by Osama Mohamed Fathy · Cairo, Egypt
# ═══════════════════════════════════════════════════════════════════

# ── CORE ──
OSS_WORK_VERSION=1.0.0-dev
ENVIRONMENT=development
# Options: production | development | test
OSS_WORK_DATA_DIR=./data
OSS_WORK_LOG_LEVEL=INFO

# ── SAFETY ──
OSS_WORK_SIMULATION_ONLY=1
# 0 = production (real actions), 1 = simulation only
OSS_WORK_ALLOWED_ROOT=./data
OSS_WORK_MAX_FILE_BYTES=10485760
OSS_WORK_MAX_OUTPUT_BYTES=65536
REQUIRE_APPROVAL_FOR_MUTATION=true
REQUIRE_APPROVAL_FOR_EXTERNAL_IO=false

# ── AI MODELS (all optional — zero-cost routes by default) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_MODEL=gemini_flash

# ── TELEGRAM ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# ── DATABASES ──
POSTGRES_URL=postgresql://osswork:osswork@localhost:5432/osswork
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── INTEGRATIONS ──
GITHUB_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── ULTRA IQ IMAGINATION ENGINE ──
ULTRA_IQ_PARALLEL_THREADS=50
ULTRA_IQ_INVENTION_ENABLED=true
ULTRA_IQ_SIMULATION_DEPTH=20
ULTRA_IQ_DOMAINS=50

# ── PERFORMANCE ──
OSS_WORK_MAX_CONCURRENT_AGENTS=5
OSS_WORK_REQUEST_TIMEOUT=120
OSS_WORK_MAX_RETRIES=3
