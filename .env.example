# ═══════════════════════════════════════════════════════════════════
# OSS WORK — COMPLETE ENVIRONMENT CONFIGURATION v1.0.0-dev
# NASA Space Apps Champion · AI Hackathon 1st Place
# Built by Osama Mohamed Fathy · Cairo, Egypt
# ═══════════════════════════════════════════════════════════════════
#
# الأوضاع المتاحة:
#   desktop  — الوكيل المستقل (CLI + API محلي)
OSS_WORK_MODE=desktop

# ── CORE ──
OSS_WORK_VERSION=1.0.0-dev
ENVIRONMENT=development
# Options: production | development | test
OSS_WORK_DATA_DIR=./data
OSS_WORK_LOG_LEVEL=INFO

# ── SAFETY ──
OSS_WORK_SIMULATION_ONLY=1
# 0 = production (real actions), 1 = simulation only
OSS_WORK_ALLOWED_ROOT=./data
OSS_WORK_MAX_FILE_BYTES=10485760
OSS_WORK_MAX_OUTPUT_BYTES=65536
REQUIRE_APPROVAL_FOR_MUTATION=true
REQUIRE_APPROVAL_FOR_EXTERNAL_IO=false

# ── AI MODELS (local engine only — no keys, no cloud) ──
DEFAULT_MODEL=oss_local

# ── DATABASES (all optional, local services) ──
POSTGRES_URL=postgresql://osswork:osswork@localhost:5432/osswork
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── ULTRA IQ IMAGINATION ENGINE ──
ULTRA_IQ_PARALLEL_THREADS=50
ULTRA_IQ_INVENTION_ENABLED=true
ULTRA_IQ_SIMULATION_DEPTH=20
ULTRA_IQ_DOMAINS=50

# ── DESKTOP / LOCAL API (read by core/config.py) ──
OSS_DESKTOP_MODE=cli
OSS_API_ENABLED=true
OSS_API_HOST=127.0.0.1
OSS_API_PORT=8080

# LOCAL INFERENCE ENGINE (llama.cpp, no API keys needed)
OSS_LOCAL_URL=http://127.0.0.1:11400
OSS_LOCAL_MODEL=qwen2.5-3b-q4_k_m
OSS_LOCAL_TIMEOUT=120

# ── OBSERVABILITY / STRUCTURED LOGGING (core/obs_logging.py) ──
SERVICE_NAME=oss-work
LOG_LEVEL=info
GIT_SHA=dev

# ── DATA / LOGGING (read by core/config.py) ──
OSS_WORK_DB_PATH=CHANGE-ME
OSS_LOG_LEVEL=INFO
OSS_LOG_TO_FILE=false
OSS_LOG_DIR=./logs

# ── SIMULATION / APPROVAL ──
OSS_APPROVED_ACTIONS=false

# ── AGENT SETTINGS ──
OSS_MAX_THREADS=1000
OSS_INVENTION_ENABLED=true
OSS_SIMULATION_DEPTH=100

# ── SECURITY GATES ──
OSS_ALLOW_FILE_OPS=false
OSS_ALLOW_CODE_EXEC=false
OSS_ALLOW_BROWSER=false
OSS_ALLOW_EXTERNAL=false

# ── API RATE LIMIT ──
OSS_RATE_LIMIT=60
OSS_RATE_WINDOW=60

# ── PERFORMANCE ──
OSS_WORK_MAX_CONCURRENT_AGENTS=5
OSS_WORK_REQUEST_TIMEOUT=120
OSS_WORK_MAX_RETRIES=3

# OSS-WORK OS v1 (independent local system — no keys, no cloud)
OSS_OS_STRICT=true
OSS_OS_DATA_DIR=./data-os
OSS_OS_SKILLS_DIR=./skills-os
OSS_OS_WORKSPACE_DIR=./workspace
