{
  "productName": "OSS Work",
  "version": "1.0.0",
  "identifier": "com.osamafathy.oss-work",
  "build": {
    "devtools": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OSS Work / OS_V1 — local console",
        "url": "http://127.0.0.1:8080/",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8080; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Utility",
    "shortDescription": "OSS Work / OS_V1 — a local, independent AI agent",
    "longDescription": "A local-first unified agent: it plans, decides, verifies, and acts on your machine, with no provider and no API key."
  },
  "plugins": {
    "debugout": {}
  }
}
